{
  "lastChangelogVersion": "0.83.0",
  "theme": "dark",
  "packages": [
    "npm:pi-web-access",
    "npm:pi-mcp-adapter",
    "npm:context-mode",
    "npm:@juicesharp/rpiv-todo",
    "npm:@tmustier/pi-ralph-wiggum",
    "npm:pi-ollama-cloud-provider",
    "npm:pi-subagents"
  ],
  "defaultProvider": "ollama-cloud",
  "defaultModel": "glm-5.2",
